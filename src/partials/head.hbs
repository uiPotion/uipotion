  <script>
    // Mobile menu toggle
    (function() {
      const toggle = document.getElementById('mobileMenuToggle');
      const menu = document.getElementById('mainMenu');
      
      if (toggle && menu) {
        toggle.addEventListener('click', function() {
          const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
          toggle.setAttribute('aria-expanded', !isExpanded);
          toggle.classList.toggle('active');
          menu.classList.toggle('active');
          document.body.classList.toggle('menu-open');
        });
        
        // Close menu when clicking on a link
        const menuLinks = menu.querySelectorAll('a');
        menuLinks.forEach(link => {
          link.addEventListener('click', function() {
            toggle.setAttribute('aria-expanded', 'false');
            toggle.classList.remove('active');
            menu.classList.remove('active');
            document.body.classList.remove('menu-open');
          });
        });
      }
    })();

    // Theme toggle: switches light and dark and remembers the choice. Without a saved
    // choice, the page follows the system setting, also when it changes.
    (function() {
      const root = document.documentElement;
      const button = document.querySelector('[data-js-theme-toggle]');
      if (!button) return;
      const metas = document.querySelectorAll('meta[name="theme-color"]');
      const colors = { light: '#faf9f6', dark: '#141412' };
      const system = window.matchMedia('(prefers-color-scheme: dark)');

      function apply(theme) {
        root.setAttribute('data-theme', theme);
        button.setAttribute('aria-label', theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
        metas.forEach(meta => meta.setAttribute('content', colors[theme]));
      }

      // The saved choice, read the same way as the head script: anything else counts as none
      function saved() {
        let theme = null;
        try { theme = localStorage.getItem('theme'); } catch (e) {}
        return theme === 'light' || theme === 'dark' ? theme : null;
      }

      apply(root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light');

      // A click during a switch toggles from the theme that switch is heading to, and only
      // the latest switch cleans up, so quick repeated clicks still alternate correctly
      let pending = null;
      let switchId = 0;

      button.addEventListener('click', function() {
        const next = (pending || root.getAttribute('data-theme')) === 'dark' ? 'light' : 'dark';
        const id = ++switchId;
        pending = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const done = function() {
          if (id === switchId) {
            pending = null;
            root.classList.remove('theme-switching');
          }
        };
        // Colors change at once (no per-element color transitions); where the browser supports
        // view transitions, the whole page cross-fades instead
        root.classList.add('theme-switching');
        if (document.startViewTransition && !reduce) {
          const transition = document.startViewTransition(function() { apply(next); });
          // A newer switch skips this one's fade, which rejects its ready promise
          transition.ready.catch(function() {});
          transition.finished.finally(done);
        } else {
          apply(next);
          void document.body.offsetHeight;
          done();
        }
      });

      system.addEventListener('change', function(event) {
        if (!saved()) apply(event.matches ? 'dark' : 'light');
      });
    })();
  </script>