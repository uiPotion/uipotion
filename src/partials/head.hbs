<!DOCTYPE html>
<html lang="en" data-hrld-root="{{hostDirName}}">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <!-- Title & Description -->
  <title>{{title}}</title>
  <meta name="description" content="{{description}}">
  
  <!-- Favicon Suite -->
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/images/favicon-16x16.png">
  {{!-- Google Search shows a site icon only in a multiple of 48 px --}}
  <link rel="icon" type="image/png" sizes="192x192" href="/assets/images/android-chrome-192x192.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#faf9f6" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#141412" media="(prefers-color-scheme: dark)">

  <script>
    // Apply the saved theme, or else the system setting, before the page paints, so it never flashes.
    // The theme toggle in the header saves the choice (see the script after the header).
    (function () {
      var theme;
      try { theme = localStorage.getItem('theme'); } catch (e) {}
      if (theme !== 'light' && theme !== 'dark') {
        theme = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
  
  <link rel="canonical" href="https://uipotion.com{{#if currentPath}}/{{currentPath}}{{/if}}">
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="{{#if agentManifest}}article{{else}}website{{/if}}">
  <meta property="og:url" content="https://uipotion.com{{#if currentPath}}/{{currentPath}}{{/if}}">
  <meta property="og:title" content="{{title}}">
  <meta property="og:description" content="{{description}}">
  <meta property="og:image" content="https://uipotion.com/assets/images/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:site_name" content="UI Potion">
  <meta property="og:locale" content="en_US">
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content="https://uipotion.com{{#if currentPath}}/{{currentPath}}{{/if}}">
  <meta name="twitter:title" content="{{title}}">
  <meta name="twitter:description" content="{{description}}">
  <meta name="twitter:image" content="https://uipotion.com/assets/images/og-image.png">
  <meta name="twitter:image:alt" content="{{title}} - UI Potion">
  
  <!-- Additional Meta -->
  <meta name="author" content="UI Potion">
  <meta name="robots" content="index, follow">
  <meta name="generator" content="haroldjs.com">
  <meta name="keywords" content="{{#if tags}}{{#each tags}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}{{else}}UI specifications, AI coding assistant, framework-agnostic, agent guides{{/if}}">
  
  {{#if agentManifest}}
  <!-- AI Agent Discovery: Machine-readable link to JSON guide -->
  <link rel="alternate" type="application/json" href="https://uipotion.com/{{agentManifest}}" title="AI Agent Guide">
  <link rel="alternate" type="text/markdown" href="https://uipotion.com/{{currentPath}}.md" title="Potion Markdown Source">
  <meta name="ai-agent-guide" content="https://uipotion.com/{{agentManifest}}">
  <meta property="og:see_also" content="https://uipotion.com/{{agentManifest}}">
  {{/if}}
  
  <!-- Fonts: self-hosted IBM Plex Sans (text) and Source Serif 4 (headings); @font-face rules live in styles/_basic.scss -->
  <link rel="preload" href="/assets/fonts/ibm-plex-sans/ibm-plex-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/source-serif-4/source-serif-4-headings-latin.woff2" as="font" type="font/woff2" crossorigin>
  
  <!-- Stylesheet -->
  <link rel="stylesheet" href="/styles/main.css">
  
  {{#if agentManifest}}
  <!-- JSON-LD Structured Data for AI Agent Discovery -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    "headline": "{{title}}",
    "description": "{{description}}",
    "author": {
      "@type": "Organization",
      "name": "UI Potion",
      "url": "https://uipotion.com"
    },
    "publisher": {
      "@type": "Organization",
      "name": "UI Potion",
      "url": "https://uipotion.com",
      "logo": {
        "@type": "ImageObject",
        "url": "https://uipotion.com/assets/images/uipotion-logo.png"
      }
    },
    "datePublished": "{{publicationDate}}",
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "https://uipotion.com{{#if currentPath}}/{{currentPath}}{{/if}}"
    },
    "image": "https://uipotion.com/assets/images/og-image.png",
    "about": {
      "@type": "SoftwareApplication",
      "applicationCategory": "UIComponentGuide",
      "operatingSystem": "Web"
    },
    "mentions": [
      {
        "@type": "DataDownload",
        "contentUrl": "https://uipotion.com/{{agentManifest}}",
        "encodingFormat": "application/json",
        "description": "AI Agent Implementation Guide (JSON)"
      },
      {
        "@type": "DataDownload",
        "contentUrl": "https://uipotion.com/{{currentPath}}.md",
        "encodingFormat": "text/markdown",
        "description": "Potion source (Markdown)"
      }
    ]{{#if tags}},
    "keywords": "{{#each tags}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}"
    {{/if}}
  }
  </script>
  {{else}}
  <!-- JSON-LD Structured Data for Website -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "UI Potion",
    "url": "https://uipotion.com",
    "description": "UI behavior guides your coding agent can apply to your existing project",
    "publisher": {
      "@type": "Organization",
      "name": "UI Potion",
      "logo": {
        "@type": "ImageObject",
        "url": "https://uipotion.com/assets/images/uipotion-logo.png"
      }
    }
  }
  </script>
  {{/if}}
</head>

