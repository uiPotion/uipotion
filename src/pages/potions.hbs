{{> head title="All Potions - UI Potion" description="Browse the full catalog of UI behavior guides your coding agent can apply to your existing project: layouts, components, features, patterns, and tooling." currentPath="potions" }}

<main class="potions-catalog-page">
  <div class="potions-catalog-hero">
    <div class="container">
      <nav class="potions-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span>All Potions</span>
      </nav>
      <h1>Complete Potions Catalog</h1>
      <p class="potions-catalog-description">
        Browse every potion: UI behavior guides your coding agent can apply to your existing project, with your own framework, components, and styling.
      </p>
    </div>
  </div>

  <section class="potions-catalog-content">
    <div class="container">
      <!-- Layouts Category -->
      <div class="potions-category-section">
        <div class="potions-category-header">
          <h2>Layouts</h2>
          <p>Full-page layouts and structural patterns for dashboards, landing pages, documentation layouts, and app shells.</p>
        </div>
        {{postsList
          className="potions-grid"
          dateFormat='dd mmmm yyyy'
          noDate=true
          byTagName="layouts"
        }}
      </div>

      <!-- Components Category -->
      <div class="potions-category-section">
        <div class="potions-category-header">
          <h2>Components</h2>
          <p>Reusable UI building blocks including buttons, dialogs, cards, forms, navigation, data tables, and more.</p>
        </div>
        {{postsList
          className="potions-grid"
          dateFormat='dd mmmm yyyy'
          noDate=true
          byTagName="components"
        }}
      </div>

      <!-- Features Category -->
      <div class="potions-category-section">
        <div class="potions-category-header">
          <h2>Features</h2>
          <p>Complete user-facing features and flows like pricing tables, authentication, e-commerce, onboarding, and search.</p>
        </div>
        {{postsList
          className="potions-grid"
          dateFormat='dd mmmm yyyy'
          noDate=true
          byTagName="features"
        }}
      </div>

      <!-- Patterns Category -->
      <div class="potions-category-section">
        <div class="potions-category-header">
          <h2>Patterns</h2>
          <p>Design and interaction patterns including drag-and-drop, infinite scroll, accessibility patterns, and responsive behaviors.</p>
        </div>
        {{postsList
          className="potions-grid"
          dateFormat='dd mmmm yyyy'
          noDate=true
          byTagName="patterns"
        }}
      </div>

      <!-- Tooling Category -->
      <div class="potions-category-section">
        <div class="potions-category-header">
          <h2>Tooling</h2>
          <p>Developer tools and infrastructure including build tools, CLI utilities, third-party integrations, and API patterns.</p>
        </div>
        {{postsList
          className="potions-grid"
          dateFormat='dd mmmm yyyy'
          noDate=true
          byTagName="tooling"
        }}
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="potions-catalog-cta">
    <div class="container">
      <div class="potions-cta-card">
        <h2>Don't See What You Need?</h2>
        <p>We're constantly adding new potions. Have a suggestion for a UI specification?</p>
        <a href="/contribute" class="button primary">Contribute a Potion</a>
      </div>
    </div>
  </section>
</main>

{{> footer}}
